  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0423\u0447\u0442\u0438\u0442\u0435, \u0447\u0442\u043E \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043D\u0438\u0437\u043A\u0438\u0445 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\u0445
    \u043F\u0440\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    \u043A\u0430\u043C\u0435\u0440 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
    \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043F\u0430\u043C\u044F\u0442\u044C
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u0440\u0430\u043D\u044C\u0448\u0435,
    \u0447\u0435\u043C \u0432\u0441\u0435 \u0430\u0441\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u044B\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0442\u0441\u044F."
